// Cloudflare Workers config for Nutflix.
// Static site from public/, API from src/worker.js (→ functions/api/[[route]].js),
// accounts stored in the D1 database "nutflix".
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nutflix",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  // serve the site on nutflix.site (and www); Cloudflare creates the DNS records and certificate on deploy
  "routes": [
    { "pattern": "nutflix.site", "custom_domain": true },
    { "pattern": "www.nutflix.site", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nutflix",
      "database_id": "330bdd95-4253-4c0e-aa59-2f6bc039e878"
    }
  ],
  // once a day at 00:10 UTC: send the NFLX payouts queued by the previous day's claims (Solana)
  "triggers": { "crons": ["10 0 * * *"] },
  // Everything runs on Solana (nothing secret here: SOLANA_TREASURY_KEY and ADMIN_KEY are dashboard secrets).
  // NFLX rewards are the "Netflix - Backpack Securities" token (Token-2022, 6 decimals).
  // Payouts only go out when PAYOUTS_ENABLED is "true" AND the SOLANA_TREASURY_KEY secret is set.
  "vars": {
    // ⬇️ LAUNCH: paste the $Nutflix mint address (CA) here. Everything else follows from it:
    //    balances and tiers are read on Solana, the price comes from DexScreener, the Buy button
    //    (Jupiter) and the CA shown on the site are generated. Leave it empty until the token exists.
    "NUT_MINT": "",
    "NFLX_MINT": "NFLX7qV57zuVxCoHy3s1jiGZyALraLNwttbxdvmYJLJ",
    "SOLANA_RPC_URL": "https://api.mainnet-beta.solana.com",
    "EXPLORER_URL": "https://solscan.io",
    "NFLX_PER_CLAIM": "0.01",
    "MAX_PER_USER_NFLX": "0.1",
    "MAX_DAILY_NFLX": "1",
    "PRIORITY_FEE": "5000",
    "PAYOUTS_ENABLED": "true"
  },
  // keep variables added in the dashboard (secrets such as ADMIN_KEY are always kept)
  "keep_vars": true,
  "observability": { "enabled": true }
}
